        "jsonOutput": "{\n  \"tool\": \"github\",\n  \"accountName\": \"RahulPersonal\",\n  \"accountType\": \"user\",\n  \"accountId\": \"Rahulgouda6\",\n  \"endpointType\": \"repo\",\n  \"requiredFields\": {\n    \"id\": \"number\",\n    \"full_name\": \"string\",\n    \"private\": \"boolean\",\n    \"created_at\": \"string\"\n  }\n}",
