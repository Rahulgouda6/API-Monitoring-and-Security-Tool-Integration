      "id": "3c78b59f-9017-4bb8-8571-a480299671b0",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const repo = $json;\n\n// pull config from Edit Fields node\nconst config = $item(0).$node[\"Edit Fields\"].json;\n\nconst accountName = config.accountName;\nconst requiredFields = config.requiredFields;\n\nconst repoName = repo.name;\n\n// helper to detect types\nfunction getType(value) {\n  if (Array.isArray(value)) return \"array\";\n  if (value === null) return \"null\";\n  return typeof value;\n}\n\nconst missingFields = [];\nconst typeChanges = [];\n\nfor (const key in requiredFields) {\n\n  if (!(key in repo)) {\n    missingFields.push(key);\n  } else {\n\n    const actualType = getType(repo[key]);\n    const expectedType = requiredFields[key];\n\n    if (actualType !== expectedType) {\n\n      typeChanges.push({\n        field: key,\n        expected: expectedType,\n        actual: actualType\n      });\n\n    }\n\n  }\n\n}\n\nlet integrationStatus = \"HEALTHY\";\n\nif (missingFields.length > 0) {\n  integrationStatus = \"CRITICAL\";\n}\nelse if (typeChanges.length > 0) {\n  integrationStatus = \"HIGH\";\n}\n\nreturn {\n  accountName,\n  repoName,\n  integrationStatus,\n  missingFields,\n  typeChanges\n};"
      },
