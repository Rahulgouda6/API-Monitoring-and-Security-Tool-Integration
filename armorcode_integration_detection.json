    {
      "parameters": {
        "jsCode": "const aggregated = $json.data;\n\nif (!aggregated || aggregated.length === 0) {\n  return null;\n}\n\nlet report = \"\";\n\nfor (const r of aggregated) {\n\n  const missing = r.missingFields?.length\n    ? r.missingFields.join(\", \")\n    : \"None\";\n\n  const typeChanges = r.typeChanges?.length\n    ? JSON.stringify(r.typeChanges, null, 2)\n    : \"None\";\n\n  report += `\nAccount: ${r.accountName}\nRepo: ${r.repoName}\nStatus: ${r.integrationStatus}\nMissing Fields: ${missing}\nType Changes: ${typeChanges}\n\n------------------------------\n`;\n\n}\n\nreturn {\n  totalAffected: aggregated.length,\n  summaryReport: report\n};"
      },
